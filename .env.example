# MentorHUB Environment Configuration
# Safe defaults are provided for local development/demo mode.
# To connect live AI capabilities or custom JWT signing, set:

# Optional: Anthropic API Key (if using Claude models)
ANTHROPIC_API_KEY=

# Optional: Gemini API Key (if using Google Gemini models)
GEMINI_API_KEY=

# Optional: Custom JWT Secret for token signing (has safe development fallback)
JWT_SECRET=
